From: Firstmate agy-integration-scout <local-draft>
Subject: [PATCH] agent/antigravity: pass prompt via --input-format stream-json stdin

Passes the prompt to `agy` as a single NDJSON `user` event on stdin using
`--print="" --input-format stream-json`, removing `opts.Prompt` from argv so
large diffs never hit OS `E2BIG` (`argument list too long`).

Applies cleanly to `kunchenguid/no-mistakes` v1.96.0 (and to v1.106.1; only the
`startNativeAgentCommand(..., opts.RequireCompletedChildren)` line in `runOnce`
differs between v1.96.0 and v1.106.1).

--- a/internal/agent/antigravity.go
+++ b/internal/agent/antigravity.go
@@ -47,7 +47,7 @@ func (a *antigravityAgent) Run(ctx context.Context, opts RunOpts) (*Result, erro
 
 func (a *antigravityAgent) Close() error { return nil }
 
-func (a *antigravityAgent) buildArgs(prompt, schemaPath, sessionID string) []string {
+func (a *antigravityAgent) buildArgs(schemaPath, sessionID string) []string {
 	// Antigravity has strict flag parsing: only --print, --json-schema, --output-format
 	// We append user extraArgs before the strict ones.
 	args := make([]string, 0, len(a.extraArgs)+11)
@@ -59,12 +59,42 @@ func (a *antigravityAgent) buildArgs(prompt, schemaPath, sessionID string) []str
 	if !antigravityUserSetPrintTimeout(a.extraArgs) {
 		args = append(args, "--print-timeout", "24h")
 	}
-	args = append(args, "--print", prompt)
+	args = append(args, "--print=", "--input-format", "stream-json")
 	if schemaPath != "" {
 		args = append(args, "--json-schema", schemaPath)
 	}
 	args = append(args, "--output-format", "stream-json")
 	return args
+}
+
+type agyStreamInputEvent struct {
+	Event   string                 `json:"event"`
+	Message agyStreamInputMessage  `json:"message"`
+}
+
+type agyStreamInputMessage struct {
+	Role    string                  `json:"role"`
+	Content []agyStreamInputContent `json:"content"`
+}
+
+type agyStreamInputContent struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+func encodeAntigravityStreamInput(prompt string) ([]byte, error) {
+	payload := agyStreamInputEvent{
+		Event: "user",
+		Message: agyStreamInputMessage{
+			Role:    "user",
+			Content: []agyStreamInputContent{{Type: "text", Text: prompt}},
+		},
+	}
+	b, err := json.Marshal(payload)
+	if err != nil {
+		return nil, err
+	}
+	return append(b, '\n'), nil
 }
 
 // antigravityUserSetPrintTimeout reports whether extraArgs already specifies
@@ -109,9 +139,14 @@ func (a *antigravityAgent) runOnce(ctx context.Context, opts RunOpts) (*Result,
 	if opts.Session != nil {
 		requestedSession = opts.Session.ID
 	}
-	args := a.buildArgs(opts.Prompt, schemaPath, requestedSession)
+	stdinPayload, err := encodeAntigravityStreamInput(opts.Prompt)
+	if err != nil {
+		return nil, fmt.Errorf("antigravity encode prompt: %w", err)
+	}
+	args := a.buildArgs(schemaPath, requestedSession)
 	cmd := exec.CommandContext(ctx, bin, args...)
 	cmd.Dir = opts.CWD
+	cmd.Stdin = bytes.NewReader(stdinPayload)
 	cmd.Env = a.gitSafeEnv(opts.CWD)
 	shellenv.ConfigureShellCommand(cmd)
 
