+
+func TestEncodeAntigravityStreamInput_LargePrompt(t *testing.T) {
+	big := strings.Repeat("x", 256*1024)
+	b, err := encodeAntigravityStreamInput(big)
+	if err != nil {
+		t.Fatalf("encodeAntigravityStreamInput() error = %v", err)
+	}
+	if !bytes.HasSuffix(b, []byte("\n")) {
+		t.Fatalf("encoded stream input must end with newline")
+	}
+	var parsed agyStreamInputEvent
+	if err := json.Unmarshal(bytes.TrimSpace(b), &parsed); err != nil {
+		t.Fatalf("unmarshal encoded stream input: %v", err)
+	}
+	if parsed.Event != "user" || parsed.Message.Role != "user" || len(parsed.Message.Content) != 1 || parsed.Message.Content[0].Text != big {
+		t.Fatalf("unexpected decoded payload: %+v", parsed)
+	}
 }
